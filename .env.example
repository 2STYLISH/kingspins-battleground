# Supabase (free tier)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI / OCR screenshot analysis (Gemini API — Google AI Studio key).
# Never expose this key to the browser. Used only in server code / API routes.
# If you switch providers later, only lib/services/screenshot-parser.ts needs to change.
AI_PROVIDER_API_KEY=          # your Gemini API key (starts with AQ. or AI...)
AI_PROVIDER_MODEL=gemini-2.5-flash   # or gemini-2.5-flash-lite for lower cost

# Public site name (used in metadata/branding)
NEXT_PUBLIC_SITE_NAME="KINGPINS BATTLEGROUND"
